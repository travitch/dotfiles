font-family = "Monaspace Neon NF"

font-feature = +calt
font-feature = +liga
font-feature = cv01=2
font-feature = +ss02
font-feature = +ss03
font-feature = +ss06

theme = "Flexoki Light"
cursor-style = "block"
shell-integration-features = no-cursor

clipboard-write = allow
clipboard-read = allow

macos-option-as-alt = true
